package main

templ AddItem(url string) {
	<div class="absolute top-0 bottom-0 left-0 right-0 flex justify-center" style="background-color: rgba(0,0,0,0.5);" id="modal">
		<form method="POST" onsubmit="return confirm('Adding an item requires manual entry of all metadata. Continue?')" class="m-10 p-10 w-3xl bg-gray-100 flex flex-col rounded-md overflow-y-scroll" action={ templ.SafeURL(url) }>
			<h1 class="text-3xl">Add Item</h1>
			<div></div>
			<input type="text" name="name" id="name" placeholder="Name" class="bg-white rounded-md p-2 m-2"/>
			<div class="format-tips">
				<b>Formatting Tips:</b> Try different formats in your metadata to organize information better.
				<span class="text-blue-500 cursor-pointer" onclick="toggleExamples()">Show examples</span>
				<div id="format-examples" style="display: none; margin-top: 10px;">
					<strong>Example 1:</strong>
					<div class="font-mono bg-gray-200 p-2 m-2 rounded-md">
						Title: Dark Side of the Moon
						<br/>
						Artist: Pink Floyd
						<br/>
						Year: 1973
						<br/>
						Condition: Excellent
						<br/>
						Notes: Original pressing
						<br/>
					</div>
					<strong>Example 2:</strong>
					<div class="font-mono bg-gray-200 p-2 m-2 rounded-md">
						Purchased:  oregon coffee and tea
						<br/>
						Cost: $2.50 per oz
						<br/>
						Flavor profile: bold and rich
						<br/>
						Temperature: 78°C
						<br/>
					</div>
				</div>
			</div>
			<textarea
				id="metadata"
				name="metadata"
				cols="50"
				rows="10"
				placeholder="Anything can go in here...
Value: $10
Artist: Claire Rosinkranz
Genre: Pop"
				class="bg-white rounded-md p-2 m-2"
				style="min-height: 20ch;"
			></textarea>
			<div class="mt-4 border-t pt-4">
				<h2 class="text-xl mb-2">Add Photos</h2>
				<!-- Camera controls -->
				<div class="flex items-center mb-4">
					<button type="button" id="startCameraBtn" class="bg-blue-500 text-white p-2 rounded-md mr-2 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg>
						Open Camera
					</button>
					<button type="button" id="captureBtn" class="bg-green-500 text-white p-2 rounded-md mr-2 hidden">
						Take Photo
					</button>
					<button type="button" id="closeCameraBtn" class="bg-red-500 text-white p-2 rounded-md hidden">
						Close Camera
					</button>
					<span class="text-gray-700 mx-2">or</span>
					<label class="bg-gray-200 p-2 rounded-md cursor-pointer">
						Upload Files
						<input type="file" id="fileInput" class="hidden" accept="image/*" multiple/>
					</label>
				</div>
				<!-- Camera view -->
				<div id="cameraContainer" class="hidden mb-4">
					<video id="cameraView" class="w-full max-h-64 bg-black rounded-md" style="transform: scaleX(-1);" autoplay playsinline></video>
				</div>
				<!-- Hidden canvas for capturing photos -->
				<canvas id="canvas" class="hidden"></canvas>
				<!-- Preview container -->
				<div id="photoPreview" class="grid grid-cols-3 gap-4 mt-4"></div>
				<!-- Hidden input to store photo data for form submission -->
				<input type="hidden" name="photoData" id="photoData"/>
			</div>
			<script>
  // Elements
  const startCameraBtn = document.getElementById('startCameraBtn');
  const captureBtn = document.getElementById('captureBtn');
  const closeCameraBtn = document.getElementById('closeCameraBtn');
  const fileInput = document.getElementById('fileInput');
  const cameraContainer = document.getElementById('cameraContainer');
  const cameraView = document.getElementById('cameraView');
  const canvas = document.getElementById('canvas');
  const photoPreview = document.getElementById('photoPreview');
  const photoDataInput = document.getElementById('photoData');

  // Store captured photos
  let photos = [];
  let stream = null;

  // Start camera
  startCameraBtn.addEventListener('click', async function() {
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'environment' }
      });
      
      cameraView.srcObject = stream;
      cameraContainer.classList.remove('hidden');
      captureBtn.classList.remove('hidden');
      closeCameraBtn.classList.remove('hidden');
      startCameraBtn.classList.add('hidden');
    } catch (err) {
      console.error("Error accessing camera:", err);
      alert("Could not access camera. Please check permissions or use file upload instead.");
    }
  });

  // Close camera
  closeCameraBtn.addEventListener('click', function() {
    if (stream) {
      stream.getTracks().forEach(track => track.stop());
      cameraView.srcObject = null;
      stream = null;
    }
    
    cameraContainer.classList.add('hidden');
    captureBtn.classList.add('hidden');
    closeCameraBtn.classList.add('hidden');
    startCameraBtn.classList.remove('hidden');
  });

  // Capture photo
  captureBtn.addEventListener('click', function() {
    if (cameraView.srcObject) {
      // Set canvas dimensions to match video
      canvas.width = cameraView.videoWidth;
      canvas.height = cameraView.videoHeight;
      
      // Draw video frame to canvas
      const context = canvas.getContext('2d');
      context.drawImage(cameraView, 0, 0, canvas.width, canvas.height);
      
      // Convert to base64
      const imageData = canvas.toDataURL('image/jpeg', 0.8);
      
      // Add to photos array
      const photoId = Date.now().toString();
      photos.push({
        id: photoId,
        data: imageData
      });
      
      // Add preview
      addPhotoPreview(photoId, imageData);
      
      // Update hidden input
      updatePhotoDataInput();
    }
  });

  // Handle file upload
  fileInput.addEventListener('change', function(e) {
    if (this.files && this.files.length > 0) {
      Array.from(this.files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function(event) {
          const photoId = Date.now().toString() + Math.random().toString(36).substring(2, 8);
          photos.push({
            id: photoId,
            data: event.target.result
          });
          
          addPhotoPreview(photoId, event.target.result);
          updatePhotoDataInput();
        };
        reader.readAsDataURL(file);
      });
    }
  });

  // Add photo preview 
  function addPhotoPreview(id, src) {
    const photoDiv = document.createElement('div');
    photoDiv.className = 'relative';
    photoDiv.dataset.id = id;
    
    photoDiv.innerHTML = `
      <img src="${src}" class="w-full h-32 object-cover rounded-md" alt="Photo preview">
      <button type="button" class="absolute top-1 right-1 bg-red-500 text-white rounded-full p-1 delete-photo" data-id="${id}">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    
    photoPreview.appendChild(photoDiv);
    
    // Add delete event
    photoDiv.querySelector('.delete-photo').addEventListener('click', function() {
      const photoId = this.dataset.id;
      photos = photos.filter(photo => photo.id !== photoId);
      photoDiv.remove();
      updatePhotoDataInput();
    });
  }

  // Update hidden input with photo data
  function updatePhotoDataInput() {
    photoDataInput.value = JSON.stringify(photos);
  }

  // Handle form submission
  const form = document.querySelector('form');
  form.addEventListener('submit', function(e) {
    // photos are already stored in the hidden input
    // continue with form submission
  });
</script>
			<button class="bg-white m-4 p-2 rounded-md ">Add Item</button>
		</form>
		<script>
        function toggleExamples() {
          const examples = document.getElementById('format-examples');
          const link = document.querySelector('.examples-link');
          if (examples.style.display === 'none') {
            examples.style.display = 'block';
            link.textContent = 'Hide examples';
          } else {
            examples.style.display = 'none';
            link.textContent = 'Show examples';
          }
        }
        </script>
	</div>
}
