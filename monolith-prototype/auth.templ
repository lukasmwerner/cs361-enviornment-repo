package main

templ Auth(title string) {
	@Page(title) {
		<div class="flex flex-col items-center justify-center gap-2 h-full">
			<form method="POST" class="border-3 rounded-lg p-6 flex flex-col items-center gap-4">
				<h1 class="text-5xl">{ title }</h1>
				if title == "Signup" {
					<input type="text" name="collection" id="collection" placeholder="My Collection" class="border-b-2 text-2xl"/>
				}
				<input type="text" name="email" id="email" placeholder="Email" class="border-b-2 text-2xl"/>
				<input type="password" name="password" id="password" placeholder="Password" class="border-b-2 text-2xl"/>
				<button class="text-2xl bg-blue-500 p-2 rounded-lg text-white">{ title }</button>
				if title == "Login" {
					<div class="flex justify-between w-full gap-2">
						<p>Don't Have an Account?</p>
						<button class="hover:italic hover:text-blue-300 hover:border-blue-300 border-b-2"><a href="/signup">Register</a></button>
					</div>
				}
				if title == "Signup" {
					<div class="flex justify-between w-full gap-2">
						<p>Have an Account?</p>
						<button class="hover:italic hover:text-blue-300 hover:border-blue-300 border-b-2"><a href="/login">Log In</a></button>
					</div>
				}
			</form>
		</div>
	}
}
