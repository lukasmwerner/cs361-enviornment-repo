package main

templ Homepage() {
	@Page("Landing Page") {
		<div class="flex flex-col items-center justify-center gap-2 h-full">
			<h1 class="text-5xl">Small Data</h1>
			<p class="text-xl w-96">Empowers collectors to track and manage their prized possessions across various categories.</p>
			<div class="flex gap-2">
				<button class="text-white bg-blue-500 p-2 rounded-lg"><a href="/login">Login</a></button>
				<button class="text-white bg-red-400 p-2 rounded-lg"><a href="/signup">Signup</a></button>
			</div>
		</div>
	}
}
